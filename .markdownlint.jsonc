{
  // MD013 (line length): wrapping Chinese prose at the default 80 would insert
  // spaces between CJK characters once rendered, so the cap is raised to 200
  // (flags only clearly overlong lines). Code blocks, tables and headings are
  // exempt from the length rule.
  "MD013": {
    "line_length": 200,
    "code_blocks": false,
    "tables": false,
    "headings": false,
    "stern": false
  },
  // MD025 (single title): the `title` in YAML front matter is not a rendered
  // heading. Keep it out of the top-level-heading count so a post enforces
  // exactly one H1 inside its body.
  "MD025": {
    "front_matter_title": ""
  },
  // MD024 (no duplicate headings): long reports reuse section names ("引言",
  // "实验", "结论") under different parent headings (one set per paper).
  // Only flag true siblings with identical text; nested duplicates are fine.
  "MD024": {
    "siblings_only": true
  },
  // MD049 (emphasis style): CJK text needs `*` (underscore does not emphasize
  // between CJK characters), while English titles use `_`; allow both rather
  // than forcing one marker everywhere.
  "MD049": false,
  // MD033 (no inline HTML): README badges and the centered header still use raw
  // HTML. Post content is kept HTML-free by tools/check-site.js instead of this
  // global rule, so the rule stays disabled for README.
  "MD033": false
}
