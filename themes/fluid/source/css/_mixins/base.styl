/* Increase the anchor offset to account for the fixed navbar height */
anchor-offset()
  &::before
    display block
    content ""
    margin-top -5rem
    height 5rem
    width 1px
    visibility hidden

/* Frosted-glass transparency effect */
ground-glass($px, $bg-color, $alpha)
  /* Enable the frosted-glass effect when backdrop-filter is supported */
  @supports (-webkit-backdrop-filter: blur($px)) or (backdrop-filter: blur($px))
    &
      background rgba(convert($bg-color), $alpha)
      -webkit-backdrop-filter blur($px)
      backdrop-filter blur($px)

  /* Fall back to a plain background when backdrop-filter is unsupported */
  @supports not ((-webkit-backdrop-filter: blur($px)) or (backdrop-filter: blur($px)))
    &
      background rgb(convert($bg-color))
