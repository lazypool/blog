<%
  const article = tide_article(page.content);
  const cats = page.categories ? page.categories.toArray() : [];
  const tags = page.tags ? page.tags.toArray() : [];
  const reading = tide_reading(page.content);
  const words = tide_words(page.content);
  const tocHtml = theme.features && theme.features.toc !== false ? toc(article, { list_number: false, max_depth: 3 }) : '';
  const hasToc = tocHtml && tocHtml.trim().length > 0;
%>
<article class="post">
  <header class="post-header card" data-reveal>
    <nav class="breadcrumbs" aria-label="面包屑">
      <a href="<%- url_for('/') %>">首页</a>
      <% cats.forEach(function (cat) { %>
        <span class="crumb-sep">/</span>
        <a href="<%- url_for(cat.path) %>"><%= cat.name %></a>
      <% }); %>
      <span class="crumb-sep">/</span>
      <span class="crumb-current" aria-current="page">正文</span>
    </nav>

    <h1 class="post-title"><%= page.title %></h1>

    <div class="post-meta post-meta--header">
      <time class="meta-item" datetime="<%= page.date.toISOString() %>">
        <%- tide_icon('calendar') %><span><%= date(page.date, 'YYYY-MM-DD') %></span>
      </time>
      <% if (theme.features && theme.features.reading_time !== false) { %>
        <span class="meta-item"><%- tide_icon('clock') %><span><%= reading %> 分钟阅读</span></span>
      <% } %>
      <span class="meta-item"><%- tide_icon('book') %><span><%= words %> 字</span></span>
      <% if (page.updated && page.updated.valueOf() !== page.date.valueOf()) { %>
        <span class="meta-item meta-updated">更新于 <%= date(page.updated, 'YYYY-MM-DD') %></span>
      <% } %>
    </div>

    <% if (tags.length) { %>
      <div class="post-tags">
        <% tags.forEach(function (tag) { %>
          <a class="tag-chip" href="<%- url_for(tag.path) %>"><%= tag.name %></a>
        <% }); %>
      </div>
    <% } %>

  </header>

  <div class="post-layout">
    <% if (hasToc) { %>
      <div class="toc-fab-wrap">
        <button class="toc-fab" type="button" data-toc-toggle aria-expanded="false" aria-controls="toc-panel" title="目录">
          <%- tide_icon('hash') %><span>目录</span>
        </button>
        <div class="toc-panel" id="toc-panel" hidden>
          <div class="toc-panel-inner">
            <p class="toc-panel-kicker">CONTENTS</p>
            <nav class="toc-body" aria-label="文章目录">
              <%- tocHtml %>
            </nav>
          </div>
        </div>
      </div>
    <% } %>
    <div class="post-content card">
      <div class="prose" data-article>
        <%- article %>
      </div>
    </div>

  </div>

  <% if (page.prev || page.next) { %>
    <nav class="post-nav" aria-label="上下篇">
      <% if (page.prev) { %>
        <a class="post-nav-item card" href="<%- url_for(page.prev.path) %>">
          <span class="post-nav-label"><%- tide_icon('arrow-right', 'flip-x') %> 上一篇</span>
          <span class="post-nav-title"><%= page.prev.title %></span>
        </a>
      <% } else { %>
        <span class="post-nav-item card is-disabled" aria-disabled="true">
          <span class="post-nav-label"><%- tide_icon('arrow-right', 'flip-x') %> 上一篇</span>
          <span class="post-nav-title">已经是最新文章了</span>
        </span>
      <% } %>
      <% if (page.next) { %>
        <a class="post-nav-item card post-nav-item--next" href="<%- url_for(page.next.path) %>">
          <span class="post-nav-label">下一篇 <%- tide_icon('arrow-right') %></span>
          <span class="post-nav-title"><%= page.next.title %></span>
        </a>
      <% } else { %>
        <span class="post-nav-item card post-nav-item--next is-disabled" aria-disabled="true">
          <span class="post-nav-label">下一篇 <%- tide_icon('arrow-right') %></span>
          <span class="post-nav-title">已经是最早的文章了</span>
        </span>
      <% } %>
    </nav>
  <% } %>
</article>
