<%
  const iconMap = { Home: 'home', Archives: 'archive', Categories: 'folder', Tags: 'tag', Photos: 'image', About: 'user' };
  const items = Object.entries(theme.menu || {});
  const brandName = (theme.author && theme.author.name) || config.title;
  const palettes = [
    { id: 'tide', name: '潮汐' },
    { id: 'abyss', name: '深海' },
    { id: 'coral', name: '珊瑚' },
    { id: 'kelp', name: '海藻' }
  ];
%>
<header class="nav-wrap">
  <nav class="nav" aria-label="主导航">
    <a class="brand" href="<%- url_for('/') %>" aria-label="<%= config.title %>">
      <span class="brand-mark"><%- tide_icon('wave') %></span>
      <span class="brand-text">
        <span class="brand-name"><%= brandName %></span>
        <span class="brand-sub">惰池 · TIDEPOOL</span>
      </span>
    </a>

    <div class="nav-links">
      <% items.forEach(function (item) { const label = item[0]; const path = item[1]; %>
        <a class="nav-link<%= tide_active(path) ? ' is-active' : '' %>" href="<%- url_for(path) %>">
          <%- tide_icon(iconMap[label] || 'link') %>
          <span><%= label %></span>
        </a>
      <% }); %>
    </div>

    <div class="nav-actions">
      <% if (theme.search && theme.search.enable !== false) { %>
        <button class="icon-btn" type="button" data-search-open aria-label="搜索" title="搜索 (Ctrl K)">
          <%- tide_icon('search') %>
        </button>
      <% } %>

      <% if (theme.features && theme.features.palette !== false) { %>
        <div class="nav-popover-wrap">
          <button class="icon-btn" type="button" data-palette-toggle aria-label="切换配色" aria-expanded="false" title="切换配色">
            <%- tide_icon('palette') %>
          </button>
          <div class="palette-pop" id="palette-pop" hidden>
            <p class="popover-title">配色</p>
            <div class="palette-grid">
              <% palettes.forEach(function (palette) { %>
                <button class="palette-item" type="button" data-palette="<%= palette.id %>">
                  <span class="palette-swatch" data-swatch="<%= palette.id %>"></span>
                  <span><%= palette.name %></span>
                </button>
              <% }); %>
            </div>
          </div>
        </div>
      <% } %>

      <button class="icon-btn" type="button" data-theme-toggle aria-label="切换明暗模式" title="切换明暗模式">
        <span class="theme-icon" data-theme-icon><%- tide_icon('sun') %></span>
      </button>

      <button class="icon-btn menu-btn" type="button" data-menu-toggle aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-menu">
        <%- tide_icon('menu') %>
      </button>
    </div>
  </nav>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="mobile-menu-links">
      <% items.forEach(function (item) { const label = item[0]; const path = item[1]; %>
        <a class="mobile-link<%= tide_active(path) ? ' is-active' : '' %>" href="<%- url_for(path) %>">
          <span class="mobile-link-icon"><%- tide_icon(iconMap[label] || 'link') %></span>
          <span><%= label %></span>
          <%- tide_icon('chevron-right', 'mobile-link-arrow') %>
        </a>
      <% }); %>
    </div>
    <div class="mobile-menu-foot">
      <span>配色</span>
      <div class="palette-grid palette-grid--inline">
        <% palettes.forEach(function (palette) { %>
          <button class="palette-item" type="button" data-palette="<%= palette.id %>">
            <span class="palette-swatch" data-swatch="<%= palette.id %>"></span>
            <span><%= palette.name %></span>
          </button>
        <% }); %>
      </div>
    </div>
  </div>
</header>
