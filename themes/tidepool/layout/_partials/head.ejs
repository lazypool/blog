<%
  const isHome = page.path === '' || page.path === 'index.html' || page.layout === 'index';
  let pageTitle = page.title || '';
  if (!pageTitle) {
    if (page.archive) pageTitle = '归档';
    else if (page.category) pageTitle = page.category;
    else if (page.tag) pageTitle = page.tag;
    else if (page.layout === 'about') pageTitle = '关于';
  }
  const fullTitle = isHome || !pageTitle ? config.title : `${pageTitle} · ${config.title}`;
  const description = page.description
    || (page.content ? tide_excerpt(page.content, 150) : '')
    || config.description
    || site.description
    || '';
  const cover = page.layout === 'post' ? tide_cover(page) : '';
  const avatar = theme.author && theme.author.avatar ? url_for(theme.author.avatar) : '';
  const rawImage = cover || avatar;
  const ogImage = rawImage
    ? (/^https?:\/\//.test(rawImage) ? rawImage : `${config.url.replace(/\/$/, '')}${rawImage}`)
    : '';
  const canonical = `${config.url.replace(/\/$/, '')}${url_for(page.path || '/')}`;
  const themeDefault = (theme.palette && theme.palette.default) || 'tide';
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="Hexo <%= config.version || '' %>">
<title><%= fullTitle %></title>
<meta name="description" content="<%= description.replace(/"/g, '&quot;') %>">
<meta name="author" content="<%= (theme.author && theme.author.name) || config.author || config.title %>">
<link rel="canonical" href="<%= canonical %>">
<meta property="og:type" content="<%= page.layout === 'post' ? 'article' : 'website' %>">
<meta property="og:site_name" content="<%= config.title %>">
<meta property="og:title" content="<%= fullTitle %>">
<meta property="og:description" content="<%= description.replace(/"/g, '&quot;') %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:locale" content="zh_CN">
<% if (page.layout === 'post' && page.date) { %>
<meta property="article:published_time" content="<%= page.date.toISOString() %>">
<% if (page.updated) { %><meta property="article:modified_time" content="<%= page.updated.toISOString() %>"><% } %>
<% (page.tags ? page.tags.toArray() : []).forEach(function (tag) { %><meta property="article:tag" content="<%= tag.name %>">
<% }); %>
<% } %>
<% if (ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } %>
<meta name="twitter:card" content="<%= ogImage ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= fullTitle %>">
<meta name="twitter:description" content="<%= description.replace(/"/g, '&quot;') %>">
<% if (ogImage) { %><meta name="twitter:image" content="<%= ogImage %>"><% } %>
<meta name="theme-color" content="#0f1c2e" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#f2f7f8" media="(prefers-color-scheme: light)">
<link rel="icon" href="<%- url_for(theme.favicon || '/img/basic/icon.png') %>">
<link rel="apple-touch-icon" href="<%- url_for(theme.favicon || '/img/basic/icon.png') %>">

<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@callmebill/lxgw-wenkai-web@latest/style.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">

<link rel="stylesheet" href="<%- url_for('/css/tokens.css') %>">
<link rel="stylesheet" href="<%- url_for('/css/base.css') %>">
<link rel="stylesheet" href="<%- url_for('/css/layout.css') %>">
<link rel="stylesheet" href="<%- url_for('/css/components.css') %>">
<link rel="stylesheet" href="<%- url_for('/css/article.css') %>">
<link rel="stylesheet" href="<%- url_for('/css/pages.css') %>">

<script>
  (function () {
    var root = document.documentElement;
    root.classList.remove('no-js');
    var saved = localStorage.getItem('tide-theme') || 'auto';
    var dark = saved === 'dark' || (saved === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    root.classList.toggle('dark', dark);
    root.dataset.theme = saved;
    root.style.colorScheme = dark ? 'dark' : 'light';
    root.dataset.palette = localStorage.getItem('tide-palette') || '<%= themeDefault %>';
  })();
</script>
