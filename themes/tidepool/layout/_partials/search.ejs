<div class="search-overlay" id="search-overlay" hidden data-search-path="<%- url_for((theme.search && theme.search.path) || '/search.json') %>">
  <div class="search-backdrop" data-search-close></div>
  <div class="search-dialog" role="dialog" aria-modal="true" aria-labelledby="search-title">
    <h2 class="sr-only" id="search-title">搜索</h2>
    <div class="search-head">
      <%- tide_icon('search') %>
      <input id="search-input" class="search-input" type="search" autocomplete="off" spellcheck="false"
        placeholder="<%= (theme.search && theme.search.placeholder) || '搜索文章、标签、分类…' %>">
      <kbd class="search-kbd">Esc</kbd>
      <button class="icon-btn search-close" type="button" data-search-close aria-label="关闭搜索">
        <%- tide_icon('close') %>
      </button>
    </div>
    <div class="search-results" id="search-results" role="listbox" aria-label="搜索结果">
      <p class="search-hint">输入关键词开始搜索</p>
    </div>
    <div class="search-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>Enter</kbd> 打开</span>
      <span><kbd>Esc</kbd> 关闭</span>
    </div>
  </div>
</div>
