# Copy this file to .env.imgbed.host and fill in local values.
# Never commit .env.imgbed.host or a private key.
IMGHOST_HOST=imgbed.example.com
IMGHOST_USER=root
IMGHOST_PRIVATE_KEY_PATH=/absolute/path/to/image-host-key.pem
IMGHOST_REMOTE_ROOT=/www/wwwroot/blog-imgbed
IMGHOST_PUBLIC_BASE_URL=https://imgbed.example.com
# IMGHOST_PORT=22
IMGHOST_ENABLED=false
